#!/usr/bin/env bash
set -euo pipefail

project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
export JAVA_HOME="$project_dir/.venv/jdk"
export PATH="$JAVA_HOME/bin:$PATH"

if [[ ! -x "$JAVA_HOME/bin/javac" ]]; then
  echo 'JDK local ausente: instale o JDK 17 em .venv/jdk.' >&2
  exit 1
fi

exec mvn -f "$project_dir/atividade-mockito/pom.xml" "-Dmaven.repo.local=$project_dir/.venv/m2" "$@"
